import telebot

bot = telebot.TeleBot("8834135501:AAGdci6DxACORffnvKaMvD9ZmYxn3B7f-9U")

@bot.message_handler(commands=['start'])
def send_welcome(message):
    bot.reply_to(message, "Привет! Я твой математический бот. Отправь мне пример с дробями через пробелы, например: 1/2 + 1/4")

@bot.message_handler(func=lambda message: True)
def handle_message(message):
       try:   
        primer = message.text
        kusochki = primer.split()
        
        drob = kusochki.split("/")
        verh = int(drob)  
        niz = int(drob)   
        
        drob2 = kusochki.split("/")
        verh2 = int(drob2)
        niz2 = int(drob2)
        znak = kusochki

        if znak == "+":
            final_verh = (verh * niz2) + (verh2 * niz)
            final_niz = niz * niz2

        elif znak == "-":
            final_verh = (verh * niz2) - (verh2 * niz)
            final_niz = niz * niz2

        elif znak == "*":
            final_verh = verh * verh2
            final_niz = niz * niz2

        elif znak == ":":
            final_verh = verh * niz2
            final_niz = niz * verh2
        bot.reply_to(message,"Ответ:" + str(final_verh) + "/" + str(final_niz))
        
    except Exception as e:
        bot.reply_to(message, "Произошла ошибка! Проверь правильность ввода.")

bot.infinity_polling()
